# Environment Variables for REST Client Tests
# Copy this to .env and fill in your values

# Server
PORT=3000
CORS_ORIGIN=*

# Database
MONGO_URI=mongodb+srv://your_mongo_connection_string

# Authentication
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=60s

# ========================================
# INFOBIP NOTIFICATION PROVIDER
# ========================================

# Base URL for Infobip API (e.g., https://api.infobip.com or region-specific)
INFOBIP_BASE_URL=https://api.infobip.com

# API Key for Infobip authentication
INFOBIP_API_KEY=your-infobip-api-key-here

# SMS Configuration
INFOBIP_SMS_SENDER_ID=Chopbaze

# WhatsApp Configuration (optional - required only if using WhatsApp)
# This should be your WhatsApp Business Account Phone Number ID from Infobip
INFOBIP_WHATSAPP_SENDER_ID=

# Email Configuration
INFOBIP_EMAIL_FROM_ADDRESS=noreply@chopbaze.com
INFOBIP_EMAIL_FROM_NAME=Chopbaze

# OTP Delivery Channels (comma-separated: SMS, EMAIL, WHATSAPP, PUSH)
# Default: SMS
OTP_CHANNELS=SMS,EMAIL

# ========================================
# LEGACY PROVIDER SUPPORT (optional)
# ========================================
# Uncomment and fill these if you want to keep Termii as fallback
# TERMII_API_KEY=your-termii-api-key
# TERMII_BASE_URL=https://api.ng.termii.com/api
# TERMII_SENDER_ID=Chopbaze

# Swagger
SWAGGER_ENABLED=true
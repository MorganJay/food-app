### Consumers API Tests
### Base URL: {{baseURL}}
@baseURL = http://localhost:3000
@token = 

# Get Consumer Profile
GET {{baseURL}}/consumers/profile
Authorization: Bearer {{token}}

###

# Update Consumer Profile
PATCH {{baseURL}}/consumers/profile
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "firstName": "Updated",
  "lastName": "Name"
}

###

# Toggle Favorite Vendor
POST {{baseURL}}/consumers/toggleFavorites
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "vendorId": "vendor_id_here"
}

###

# Get Consumer Orders
GET {{baseURL}}/consumers/orders
Authorization: Bearer {{token}}

###

# Get Consumer Favorites
GET {{baseURL}}/consumers/favorites
Authorization: Bearer {{token}}

###

# List Consumer Delivery Addresses
GET {{baseURL}}/consumers/addresses
Authorization: Bearer {{token}}

###

# Create Consumer Delivery Address
POST {{baseURL}}/consumers/addresses
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "label": "Home",
  "addressLine": "123 Ring Road, Ibadan",
  "city": "Ibadan",
  "state": "Oyo",
  "postalCode": "200001",
  "country": "NG",
  "location": { "lat": 7.3775, "lng": 3.9470 },
  "instructions": "Leave at the gate",
  "isDefault": true
}

###

@addressId =

# Update Consumer Delivery Address
PUT {{baseURL}}/consumers/addresses/{{addressId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "label": "Home",
  "instructions": "Leave at the back gate"
}

###

# Delete Consumer Delivery Address
DELETE {{baseURL}}/consumers/addresses/{{addressId}}
Authorization: Bearer {{token}}